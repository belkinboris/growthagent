DATABASE_URL=
PUBLIC_URL=

BOT_TOKEN=
BOT_ADMIN_CHAT_IDS=
# Релей Telegram Bot API через Cloudflare Worker (как в АвтоПосте) --
# обязателен на Timeweb, прямой api.telegram.org оттуда ненадёжен.
TELEGRAM_API_BASE=

# --- Веб-платформа (обязательно для доступа к сайту-аналитику) ---
# Без PLATFORM_ADMIN_PASSWORD платформа /growth недоступна никому.
PLATFORM_ADMIN_PASSWORD=
# Ключ подписи сессий (любая длинная случайная строка). Если пусто --
# сессии сбрасываются при рестарте процесса.
PLATFORM_SECRET_KEY=

# LLM_PROVIDER: none | anthropic | yandex
# Для серверов в РФ используйте yandex -- Anthropic API с российских IP недоступен.
LLM_PROVIDER=yandex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Yandex Cloud LLM (LLM_PROVIDER=yandex) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# native = YandexGPT (Foundation Models), openai = DeepSeek/Qwen (AI Studio Responses API)
YANDEX_API_MODE=openai
YANDEX_MODEL=deepseek-v4-flash/latest
# Для режима native (если пусто -- gpt://{YANDEX_FOLDER_ID}/yandexgpt/latest):
YANDEX_MODEL_URI=

# --- Проект из env (LEGACY, можно не заполнять) ---
# Основной способ подключения проектов -- мастер на веб-платформе /growth
# (вкладка "Проекты": название + адрес + токен, хранится в БД аналитика).
# Эти переменные оставлены для совместимости с v1: если PROJECT_BASE_URL
# пуст, env-проект не создаётся вовсе.
PROJECT_NAME=АвтоПост
PROJECT_TYPE=telegram_saas
PROJECT_CONNECTOR=truepost
PROJECT_BASE_URL=
PROJECT_INTERNAL_API_TOKEN=

YANDEX_OAUTH_TOKEN=
METRIKA_COUNTER_ID=109941485
METRIKA_GOAL_IDS_JSON={"signup": 123456, "activation_1": 123457, "activation_2": 123458, "payment_started": 123459, "payment_success": 123460}

# Запись в Метрику (задача F6, Маркетолог на уровне автономии 3) --
# ОТДЕЛЬНЫЙ токен от YANDEX_OAUTH_TOKEN выше: тот выпущен только с правом
# metrika:read (чтение статистики), а для создания/правки целей через
# Management API нужен токен с правом metrika:write ("Создание счётчиков,
# изменение параметров своих и доверенных счётчиков"). Выпускается тем же
# приложением на oauth.yandex.ru -- добавьте это право в настройках
# приложения и получите новый токен по ссылке
# https://oauth.yandex.ru/authorize?response_type=token&client_id=<ваш_client_id>
METRIKA_MANAGEMENT_TOKEN=
# Условие цели "оплата успешна" -- без него Маркетолог не сможет сам
# пересоздать цель payment_success (не может придумать URL/событие оплаты
# сам). Формат -- как в Management API: {"type": "url"|"event"|...,
# "conditions": [...]}. Пример для URL-цели на странице /success:
# METRIKA_PAYMENT_SUCCESS_GOAL_CONDITION_JSON={"type": "url", "conditions": [{"type": "contain", "url": "/success"}]}
METRIKA_PAYMENT_SUCCESS_GOAL_CONDITION_JSON=

# DIRECT_OAUTH_TOKEN опционален, если задан YANDEX_OAUTH_TOKEN выше --
# Growth Agent использует один общий OAuth-токен Яндекса для Метрики и
# Директа, если отдельный токен для Директа не указан. Задавайте отдельно
# только если используете разные токены/аккаунты для этих двух сервисов.
DIRECT_OAUTH_TOKEN=
DIRECT_CLIENT_LOGIN=
# Список ID кампаний через запятую, без пробелов. Если оставить пустым --
# Growth Agent будет получать отчёт по ВСЕМ кампаниям аккаунта.
DIRECT_CAMPAIGN_IDS=12345,67890
DIRECT_SANDBOX=false

# Технические детали Direct connector (не требуют действий, для справки):
# запрос к Reports Service выполняется с заголовком returnMoneyInMicros=true,
# поэтому суммы Cost/AvgCpc в ответе API приходят умноженными на 1_000_000 --
# connector делит их обратно, чтобы получить рубли. Если вы видите аномально
# большие суммы расхода в логах -- это первое, что стоит проверить.

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Коммерция самой платформы (не оплата продукта, который анализируем) ---
# Выключено по умолчанию: пока платформа обслуживает только своего владельца,
# лимитов и оплаты нет вообще. Включить одной переменной, когда решите
# отдавать аналитик другим фаундерам за деньги -- код менять не нужно.
COMMERCIAL_MODE=false
# Отдельный магазин ЮKassa: НЕ тот же, что YOOKASSA_SHOP_ID выше (тот читает
# оплаты анализируемого продукта, это разные деньги и разные ключи).
PLATFORM_YOOKASSA_SHOP_ID=
PLATFORM_YOOKASSA_SECRET_KEY=
PLATFORM_YOOKASSA_RETURN_URL=

WATCH_INTERVAL_SECONDS=10800
DEFAULT_MODE=watch_only
INTEGRATION_STALE_MINUTES=180

# --- Задачи в разработку (GitHub Issue → Claude Code), см. AUTOMATION.md ---
# Аналитик кнопкой «В разработку» создаёт issue с диагнозом; если в репозитории
# настроен workflow Claude Code (реагирует на @claude), задача уходит в работу.
GITHUB_TASK_REPO=
GITHUB_TASK_TOKEN=
